//check name is valid or not
//two words only
bool ValidName(string Name)
{
    int spaces = 0;
    for (int i = 0; i < Name.length(); i++)
    {
        if (Name[i] == ' ')
            spaces++;
    }
    if (spaces == 1)
        return true;
    else
        return false;
}

//check national id is valid or not
//14 digit and not start with 0
bool ValidNationalID(string ID)
{
    if (ID.length() != 14)
        return false;

    if (ID[0] == '0')
        return false;
    for (int i = 0; i < ID.length(); i++)
        if (ID[i] < '0' || ID[i]>'9')
            return false;


    return true;
}

//not repeated national id
bool UniqueNationalID(string ID)
{
    for (int i = 0; i < NumberOfStudents; i++)
    {
        if (students[i].NationalID == ID)
            return false;
    }
    return true;
}

//check gender is valid or not
//must be M or F whether capital or lowercase
bool ValidGender(string Gender)
{
    if (Gender == "M" || Gender == "m" || Gender == "F" || Gender == "f")
        return true;
    else
        return false;
}

//check date of birth is valid or not
//must be in this format(DD/MM/YYYY)
//the age must be >=17
bool ValidDOB(string date)
{
    if (date.length() != 10)
        return false;

    if (date[2] != '/' || date[5] != '/')
        return false;

    int day = (date[0] - '0') * 10 + (date[1] - '0');
    int month = (date[3] - '0') * 10 + (date[4] - '0');
    int year = (date[6] - '0') * 1000 + (date[7] - '0') * 100 +
        (date[8] - '0') * 10 + (date[9] - '0');

    if (day < 1 || day > 31)
        return false;

    if (month < 1 || month > 12)
        return false;

    if (2026 - year < 17)
        return false;

    return true;
}

// check phone number is valid or not
// must be 11 digits and start with 01
bool ValidPhone(string phone)
{
    if (phone.length() != 11)
        return false;

    if (phone[0] != '0' || phone[1] != '1')
        return false;
    for (int i = 0; i < phone.length(); i++)
        if (phone[i] < '0' || phone[i]>'9')
            return false;

    return true;
}

// check program is valid or not
// the program must be COMM or CAIE or MCTA
bool ValidProgram(string program)
{
    if (program == "COMM" || program == "CAIE" || program == "MCTA")
        return true;
    else
        return false;
}

bool ValidLevel(int level)
{
    if (level >= 1 && level <= 4)
        return true;
    else
        return false;
}

// check course code is valid or not
// must be 3 letters + 3 digits
bool ValidCourseCode(string code)
{
    if (code.length() != 6)
        return false;

    for (int i = 0; i < 3; i++)
        if (code[i] < 'A' || code[i] > 'Z')
            return false;

    for (int i = 3; i < 6; i++)
        if (code[i] < '0' || code[i] > '9')
            return false;

    return true;
}

// not repeated course code
bool UniqueCourseCode(string code)
{
    for (int i = 0; i < NumberOfCourses; i++)
    {
        if (courses[i].code == code)
            return false;
    }
    return true;
}

// check credit hours is valid or not
bool ValidCreditHours(int ch)
{
    if (ch >= 1 && ch <= 4)
        return true;
    else
        return false;
}

// automatic generate ID
void GenerateID()
{
    string ID = "26P";

    if (IDcount < 10)
        ID += "000";
    else if (IDcount < 100)
        ID += "00";
    else if (IDcount < 1000)
        ID += "0";

    string NumStr = "";
    int temp = IDcount;

    while (temp > 0)
    {
        int digit = temp % 10;
        char c = digit + '0';
        NumStr = c + NumStr;
        temp /= 10;
    }

    students[NumberOfStudents].studentID = ID + NumStr;
    IDcount++;
}

// find the index of the student
int FindStudentByID(string id)
{
    for (int i = 0; i < NumberOfStudents; i++)
    {
        if (students[i].studentID == id)
            return i;
    }
    return -1;
}

//find the index of the course
int FindCourseByCode(string code)
{
    for (int i = 0; i < NumberOfCourses; i++)
    {
        if (courses[i].code == code)
            return i;
    }
    return -1;
}

//the letter of the grade
//A+/A/A-/B+/B/B-/C+/C/C-/D+/D/F
string GetLetterGrade(int total, float& points)
{
    if (total >= 97)
    {
        points = 4.0;
        return "A+";
    }
    else if (total >= 93)
    {
        points = 4.0;
        return "A";
    }
    else if (total >= 89)
    {
        points = 3.7;
        return "A-";
    }
    else if (total >= 84)
    {
        points = 3.3;
        return "B+";
    }
    else if (total >= 80)
    {
        points = 3.0;
        return "B";
    }
    else if (total >= 76)
    {
        points = 2.7;
        return "B-";
    }
    else if (total >= 73)
    {
        points = 2.3;
        return "C+";
    }
    else if (total >= 70)
    {
        points = 2.0;
        return "C";
    }
    else if (total >= 67)
    {
        points = 1.7;
        return "C-";
    }
    else if (total >= 64)
    {
        points = 1.3;
        return "D+";
    }
    else if (total >= 60)
    {
        points = 1.0;
        return "D";
    }
    else
    {
        points = 0.0;
        return "F";
    }
}

//recalculate GPA 
void RecalculateGPA(int sidx)
{
    float totalPoints = 0.0;
    int totalCredits = 0;

    for (int i = 0; i < NumberOfGrades; i++)
    {
        if (grades[i].studentID != students[sidx].studentID)
            continue;

        int cidx = FindCourseByCode(grades[i].courseCode);
        if (cidx == -1)
            continue;

        totalPoints += grades[i].points * courses[cidx].creditHours;
        totalCredits += courses[cidx].creditHours;
    }

    if (totalCredits > 0)
        students[sidx].gpa = totalPoints / totalCredits;
    else
        students[sidx].gpa = 0.0;
}

