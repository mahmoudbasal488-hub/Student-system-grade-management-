        if (!ValidDOB(students[NumberOfStudents].dob))
            cout << "ERROR: Invalid DOB or age must be 17+\n";

    } while (!ValidDOB(students[NumberOfStudents].dob));

    do
    {
        cout << "Enter Phone Number: ";
        cin >> students[NumberOfStudents].phone;
        if (!ValidPhone(students[NumberOfStudents].phone))
            cout << "ERROR: Phone must be 11 digits starting with 01\n";

    } while (!ValidPhone(students[NumberOfStudents].phone));

    do
    {
        cout << "Enter Program (COMM/CAIE/MCTA): ";
        cin >> students[NumberOfStudents].program;
        if (!ValidProgram(students[NumberOfStudents].program))
            cout << "ERROR: Program must be COMM, CAIE, or MCTA\n";

    } while (!ValidProgram(students[NumberOfStudents].program));

